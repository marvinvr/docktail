# DockTail configuration.
# Copy to .env and uncomment what you need. Every variable below is documented
# in docs/07-reference.md (https://docktail.org/docs/#reference); the defaults
# shown in comments are what DockTail uses when the variable is unset.

# =============================================================================
# Tailscale sidecar (only for docker-compose.sidecar.yaml)
# =============================================================================

# Auth key for the tailscale/tailscale sidecar container. Not read by DockTail
# itself -- skip it when the host already runs tailscaled.
# Generate one at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-xxxxx

# =============================================================================
# Tailscale API credentials (optional, choose ONE method)
# =============================================================================
# Without credentials DockTail advertises services locally but cannot create
# Service definitions in the admin console. If both methods are set, OAuth wins.

# Option 1: OAuth client credentials (recommended -- never expires)
# Create at: https://login.tailscale.com/admin/settings/oauth
# Scope the client to your server tag (for example tag:server) and grant only:
#   - General -> Services: Write (specify the required tag)
#   - Devices -> Core: Write
#   - Keys -> Auth Keys: Write (only when using the sidecar method)
# These also cover DELETE_UNUSED_SERVICES and DockTail Cloud tailnet health.
# See docs/03-tailscale-admin.md (https://docktail.org/docs/#oauth-credentials).
# TAILSCALE_OAUTH_CLIENT_ID=
# TAILSCALE_OAUTH_CLIENT_SECRET=

# Option 2: API key (expires every 90 days)
# Generate at: https://login.tailscale.com/admin/settings/keys
# TAILSCALE_API_KEY=tskey-api-xxxxx

# Credentials can be read from mounted secret files instead. The direct variable
# wins; otherwise DockTail checks FILE__<NAME> first and <NAME>_FILE second.
# FILE__TAILSCALE_OAUTH_CLIENT_ID=/run/secrets/docktail/tailscale_oauth_client_id
# FILE__TAILSCALE_OAUTH_CLIENT_SECRET=/run/secrets/docktail/tailscale_oauth_client_secret
# FILE__TAILSCALE_API_KEY=/run/secrets/docktail/tailscale_api_key

# Tailnet ID. Defaults to the tailnet the credential belongs to.
# Find yours at https://login.tailscale.com/admin/settings/general
# TAILSCALE_TAILNET=example.com

# =============================================================================
# Service reconciliation
# =============================================================================

# Tags applied to services whose container sets no docktail.tags label. Tags are
# reconciled every cycle, so manual edits in the admin console are overwritten.
# DEFAULT_SERVICE_TAGS=tag:container

# Comma-separated service names DockTail must never drain, clear, or delete.
# Accepts bare names (grafana) and fully qualified names (svc:grafana).
# IGNORE_SERVICE_NAMES=

# Delete tailnet Service definitions that no host advertises anymore. Requires
# API credentials. Safe alongside other DockTail instances: a Service advertised
# by any host is never deleted.
# DELETE_UNUSED_SERVICES=false

# Leave services and Funnels advertised when DockTail shuts down. Only affects
# graceful shutdown. Caution: while DockTail is down this keeps ports exposed on
# the tailnet, potentially beyond what your labels define -- a container you stop
# or unlabel stays reachable until DockTail restarts and reconciles it away.
# SKIP_SHUTDOWN_CLEANUP=false

# How often DockTail reconciles container state against the tailnet.
# RECONCILE_INTERVAL=60s

# =============================================================================
# Sockets and runtime
# =============================================================================

# Docker daemon socket. Rootless Docker typically uses
# unix:///run/user/<uid>/docker.sock; a read-only socket proxy is
# tcp://docker-socket-proxy:2375 (docs/02-security.md).
# DOCKER_HOST=unix:///var/run/docker.sock

# Standard Docker client variables, only needed for a TLS-protected tcp://
# daemon or to pin the API version (negotiated by default).
# DOCKER_CERT_PATH=
# DOCKER_TLS_VERIFY=1
# DOCKER_API_VERSION=

# tailscaled socket probed by the socket-loss check. The bundled tailscale CLI
# always uses /var/run/tailscale/tailscaled.sock, so mount the daemon's socket
# directory at /var/run/tailscale regardless.
# TAILSCALE_SOCKET=/var/run/tailscale/tailscaled.sock

# Exit when the Tailscale socket stays unreachable past the grace period, so the
# container's restart policy can re-establish the mount. Needs a restart policy.
# EXIT_ON_SOCKET_LOSS=true

# How long the Tailscale socket may stay unreachable before DockTail exits. Must
# stay comfortably longer than a normal tailscaled restart.
# SOCKET_LOSS_GRACE_PERIOD=90s

# Logging level for all output, including the cloud module: debug, info, warn,
# or error.
# LOG_LEVEL=info

# Log lines are colored only on a terminal. Any value disables color there too.
# NO_COLOR=1

# =============================================================================
# DockTail Cloud (optional)
# =============================================================================
# Opt-in reporting to cloud.docktail.org, a paid service. The module is
# completely inert unless DOCKTAIL_CLOUD_KEY is set. See docs/06-cloud.md
# (https://docktail.org/docs/#docktail-cloud) and docker-compose.cloud.yaml.

# Workspace key (dtc_...) from the cloud dashboard.
# DOCKTAIL_CLOUD_KEY=

# Read but currently has no effect; LOG_LEVEL sets the cloud module's level.
# DOCKTAIL_LOG_LEVEL=info

# How often local-vantage checks run (5s to 5m). An invalid value keeps the
# cloud module from starting.
# DOCKTAIL_CHECK_INTERVAL=30s

# Where the host's root filesystem is bind-mounted read-only (- /:/host:ro) to
# report disk usage for every host filesystem. Used only when mounted.
# DOCKTAIL_HOST_ROOT=/host

# Local development only: override the ingest endpoint. Plaintext ws:// is
# accepted for loopback hosts, or elsewhere with DOCKTAIL_CLOUD_ALLOW_INSECURE.
# Never use either in production.
# DOCKTAIL_CLOUD_URL=ws://localhost:8080/v1/agent
# DOCKTAIL_CLOUD_ALLOW_INSECURE=false
